# Maven
target/

# Angular / node
ui/node_modules/
ui/.angular/
ui/dist/
*.log

# The console is built here by vite (see ui/vite.config.ts). Generated output, never committed —
# but it must live in the source tree so that every build path picks it up as a normal resource.
src/main/resources/static/

# IDE
.idea/
*.iml
.vscode/

# Local secrets + data — never commit.
# ./config is Spring Boot's own external config directory: it is loaded automatically, which makes
# it the right home for credentials that must never reach a tracked file.
config/
data/
secrets.properties
logs/
