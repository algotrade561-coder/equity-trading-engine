<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.equity</groupId>
    <artifactId>equity</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>equity</name>
    <description>Intraday equity momentum engine — multi-user, LIVE and REPLAY</description>

    <properties>
        <java.version>21</java.version>
        <!-- -Dskip.ui=true builds the jar without rebuilding the console. -->
        <skip.ui>false</skip.ui>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistence. H2 in file mode with MODE=PostgreSQL: everything the engine learns survives
             a restart, and the SQL stays portable so the move to a real Postgres is a URL change
             rather than a rewrite. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Google sign-in. The engine has no password of its own to store or leak. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Kite streaming is a raw binary WebSocket; OkHttp is the smallest thing that does it well. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Order placement is tested against a real HTTP server rather than a mocked client, so the
             request Kite would actually receive (path, form body, auth header) is what gets asserted. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Package-boundary rules replace what module boundaries used to enforce at build time. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          AWS SDK v2, EC2 only. Provisions one Elastic IP per user so each user's broker traffic can
          leave from the address their API key is registered to (SEBI static-IP rule). Credentials
          come from the instance's IAM role via IMDSv2 at runtime; no access key is configured,
          stored, or entered anywhere. Version pinned by the BOM below. Off-box the code runs
          against a mock and never touches the SDK.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.31.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>equity</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Builds the React console into target/classes/static during `mvn package`, so the jar
              serves both the API and the UI. One artefact to deploy, and no chance of shipping a
              front end built from a different commit than the back end.

              Node is downloaded and pinned rather than taken from the machine: a build that depends
              on whatever node the developer happens to have is a build that works differently for
              everyone. Skip it with -Dskip.ui=true when iterating on Java only.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>ui</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <skip>${skip.ui}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <nodeVersion>v22.11.0</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>ci</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <!--
                          generate-resources: before process-resources copies src/main/resources
                          into target/classes, so the freshly built console is part of that copy
                          like any other resource. Every build path then produces it — package,
                          test, spring-boot:run, and plain compile.
                        -->
                        <phase>generate-resources</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
